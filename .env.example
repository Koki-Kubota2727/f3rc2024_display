# Docker 環境変数（docker-compose.yml で参照）

# Node.js 環境
NODE_ENV=production
PORT=3000

# PostgreSQL 設定
DB_HOST=postgres
DB_PORT=5432
DB_NAME=f3rc_display
DB_USER=f3rc_user
DB_PASSWORD=f3rc_password

# （開発環境の場合）ローカル PostgreSQL 接続
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=f3rc_display
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password
